{
  "openapi": "3.1.0",
  "info": {
    "title": "Genomic Trait Visualizer",
    "version": "0.1.0"
  },
  "paths": {
    "/analyze/": {
      "post": {
        "tags": [
          "analyze"
        ],
        "summary": "Analyze Dna",
        "operationId": "analyze_dna_analyze__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_dna_analyze__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TraitAnalysisSummary"
                  },
                  "type": "array",
                  "title": "Response Analyze Dna Analyze  Post"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported DNA upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traits/": {
      "get": {
        "tags": [
          "traits"
        ],
        "summary": "Read Traits",
        "operationId": "read_traits_traits__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TraitCatalogSummary"
                  },
                  "type": "array",
                  "title": "Response Read Traits Traits  Get"
                }
              }
            }
          }
        }
      }
    },
    "/traits/{trait_id}": {
      "get": {
        "tags": [
          "traits"
        ],
        "summary": "Read Trait",
        "operationId": "read_trait_traits__trait_id__get",
        "parameters": [
          {
            "name": "trait_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trait Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraitCatalogDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traits/{trait_id}/evaluate": {
      "post": {
        "tags": [
          "traits"
        ],
        "summary": "Evaluate Trait",
        "operationId": "evaluate_trait_traits__trait_id__evaluate_post",
        "parameters": [
          {
            "name": "trait_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trait Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_evaluate_trait_traits__trait_id__evaluate_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
