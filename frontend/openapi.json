                    "$ref": "#/components/schemas/RsidCatalogItem"
                  },
                  "type": "array",
                  "title": "Response Read Rsids Rsids  Get"
                }
              }
            }
          }
        }
      }
    },
    "/rsids/{rsid}": {
      "get": {
        "tags": [
          "rsids"
        ],
        "summary": "Read Rsid",
        "operationId": "read_rsid_rsids__rsid__get",
        "parameters": [
          {
            "name": "rsid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rsid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
